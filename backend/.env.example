# Copy to .env for local development.
# HS256 key for JWTs: use 32+ random characters (Render: "Generate").
SECRET_KEY=change-me-to-a-long-random-string-32-plus-chars
# Comma-separated, no trailing slashes.
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./signal.db
# Optional: seconds a user stays "online" after their last socket closes (default 5).
# PRESENCE_GRACE_SECONDS=5
